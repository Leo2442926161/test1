# Application Kconfig. EVT image claim stays off.

menu "Zephyr"
source "Kconfig.zephyr"
endmenu

config CHAOJI_SMOKE_EVT_IMAGE
	bool "Produce the EVT flash image"
	default n
	help
	  Leave disabled. The application links fw_node, fw_ux, and fw_status
	  and can print their JSON on the DK console, but RTT is not linked,
	  UART_DBG is still PIN_TBD, and no west image is checked in.
	  main.c refuses to compile when this symbol is set.
